---
import Prueba from '../../layouts/Prueba.astro';
const campo = 'min-height: 44px; border: 1.5px solid var(--ink); border-radius: 10px; padding: 0 14px; font: inherit; font-weight: 400';
---
<Prueba title="Apóyanos">
  <section class="wrap" style="padding-top: 72px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 20px">
    <p class="kicker">Apóyanos</p>
    <h1 class="titulo">Ayuda a que el aquelarre siga creciendo</h1>
  </section>

  <section class="wrap row" aria-labelledby="h-don" style="padding-top: 32px; padding-bottom: 64px; align-items: stretch">
    <div style="flex: 3 1 420px; display: flex; flex-direction: column; gap: 18px">
      <h2 id="h-don" style="margin: 0; font-size: 36px; font-weight: 800; letter-spacing: -0.02em">Dona</h2>
      <p style="margin: 0; font-size: 18px; line-height: 1.7; max-width: 52ch">[A qué se destinan las donaciones: premios de torneos, espacios para eventos, producción de contenido…]</p>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 16px">
        {[1, 2, 3].map(() => (
          <div class="lift box" style="display: flex; flex-direction: column; gap: 6px"><strong style="font-size: 28px">[$ MONTO]</strong><span style="color: var(--muted)">[Qué se logra con esto]</span></div>
        ))}
      </div>
      <div><a class="btn dark" href="#">Donar en [PLATAFORMA: Vaki u otra]</a></div>
    </div>
    <div class="ph" style="flex: 2 1 280px; min-height: 340px; border-radius: 16px">GATO (nuevo diseño) o FOTO DE LA COMUNIDAD</div>
  </section>

  <section id="marcas" class="wrap oscura" aria-labelledby="h-mar" style="padding-top: 64px; padding-bottom: 64px">
    <div class="row" style="gap: 40px">
      <div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 16px">
        <h2 id="h-mar" style="margin: 0; font-size: 36px; font-weight: 800; letter-spacing: -0.02em">Para marcas</h2>
        <p style="margin: 0; font-size: 18px; line-height: 1.7; color: #D0D0D0">[Por qué aliarse con Aquelarre: la comunidad, el alcance, los eventos]</p>
        <div class="chips" style="gap: 12px"><a class="btn" href="#">Descargar dossier</a><a class="btn ghost" href="#contacto">Escríbenos</a></div>
      </div>
      <ul style="flex: 1 1 340px; margin: 0; padding: 0; list-style: none; font-size: 22px; font-weight: 700">
        <li style="border-top: 1.5px solid #555; padding: 18px 0">Patrocinio de torneos</li>
        <li style="border-top: 1.5px solid #555; padding: 18px 0">Activaciones en eventos</li>
        <li style="border-top: 1.5px solid #555; padding: 18px 0">Contenido con creadoras</li>
        <li style="border-top: 1.5px solid #555; border-bottom: 1.5px solid #555; padding: 18px 0">[OTRA FORMA DE COLABORAR]</li>
      </ul>
    </div>
  </section>

  <section class="wrap" aria-labelledby="h-ali" style="padding-top: 56px; padding-bottom: 56px">
    <h2 id="h-ali" style="margin: 0 0 24px; font-size: 28px; font-weight: 800">Han confiado en nosotras</h2>
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px">
      {[1, 2, 3, 4, 5, 6].map(() => <div class="ph" style="height: 80px">LOGO</div>)}
    </div>
  </section>

  <section id="contacto" class="wrap row" aria-labelledby="h-con" style="gap: 40px; padding-top: 56px; padding-bottom: 72px; border-top: 1.5px solid var(--ink)">
    <h2 id="h-con" class="sec" style="flex: 1 1 240px">Escríbenos</h2>
    <form style="flex: 2 1 420px; display: flex; flex-direction: column; gap: 16px" onsubmit="event.preventDefault(); alert('Formulario de prueba: todavía no envía nada.');">
      <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Nombre<input type="text" name="nombre" style={campo} /></label>
      <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Correo<input type="email" name="correo" style={campo} /></label>
      <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Marca u organización<input type="text" name="marca" style={campo} /></label>
      <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 600">Mensaje<textarea name="mensaje" rows="5" style="border: 1.5px solid var(--ink); border-radius: 10px; padding: 12px 14px; font: inherit; font-weight: 400"></textarea></label>
      <div><button type="submit" class="btn dark">Enviar</button></div>
    </form>
  </section>
</Prueba>
