---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AutoraTag from '../../components/Autora.astro';
import { notasPublicadas, autoraDe, fechaBonita, type Nota } from '../../lib/notas';

export async function getStaticPaths() {
  const notas = await notasPublicadas();
  return notas.map((nota) => ({ params: { id: nota.id }, props: { nota } }));
}

const { nota } = Astro.props as { nota: Nota };
const autora = await autoraDe(nota);
const { Content } = await render(nota);
---
<Base title={`${nota.data.titulo} — Aquelarre`} description={nota.data.resumen ?? undefined}>
  <article style="max-width: 760px; margin: 0 auto; padding: 48px 20px 0; display: flex; flex-direction: column; gap: 20px">
    <a href="/notas/" style="font-weight: 600">← Todas las notas</a>
    <span class="meta">{nota.data.categoria ?? 'Nota'} · {fechaBonita(nota.data.fecha)}</span>
    <h1 style="margin: 0; font-size: clamp(34px, 5vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08">{nota.data.titulo}</h1>
    {nota.data.resumen && <p style="margin: 0; font-size: 21px; color: #333">{nota.data.resumen}</p>}
    <AutoraTag autora={autora} />
    {nota.data.portada && <img src={nota.data.portada} alt="" style="width: 100%; border-radius: 16px; margin: 8px 0" />}
    <div class="cuerpo">
      <Content />
    </div>
  </article>
</Base>

<style>
  .cuerpo :global(p) { font-size: 19px; line-height: 1.75; margin: 0 0 22px; }
  .cuerpo :global(h2) { font-size: 28px; font-weight: 800; margin: 32px 0 14px; }
  .cuerpo :global(h3) { font-size: 22px; font-weight: 700; margin: 28px 0 12px; }
  .cuerpo :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
  .cuerpo :global(blockquote) { margin: 8px 0 28px; padding: 4px 0 4px 24px; border-left: 3px solid #111; font-size: 22px; font-weight: 700; }
  .cuerpo :global(ul), .cuerpo :global(ol) { font-size: 19px; line-height: 1.75; }
</style>
