---
import Base from '../../layouts/Base.astro';
import AutoraTag from '../../components/Autora.astro';
import { notasPublicadas, autoraDe, fechaBonita } from '../../lib/notas';

const notas = await notasPublicadas();
const items = await Promise.all(notas.map(async (n) => ({ nota: n, autora: await autoraDe(n) })));
---
<Base title="Notas — Aquelarre">
  <section class="wrap" style="padding-top: 64px; padding-bottom: 24px">
    <p class="meta" style="margin: 0 0 12px">Blog</p>
    <h1 style="margin: 0; font-size: clamp(40px, 6vw, 80px); font-weight: 800; letter-spacing: -0.03em; line-height: 1">Notas</h1>
  </section>

  <section class="wrap" style="padding-top: 24px">
    {items.length === 0 && <p style="color: var(--muted)">Todavía no hay notas publicadas.</p>}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px">
      {items.map(({ nota, autora }) => (
        <article style="display: flex; flex-direction: column; gap: 10px">
          <a href={`/notas/${nota.id}/`} style="text-decoration: none; display: flex; flex-direction: column; gap: 10px">
            {nota.data.portada
              ? <img src={nota.data.portada} alt="" style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 16px" loading="lazy" />
              : <div class="ph" style="aspect-ratio: 16 / 10; border-radius: 16px">sin imagen</div>}
            <span class="meta">{nota.data.categoria ?? 'Nota'} · {fechaBonita(nota.data.fecha)}</span>
            <strong style="font-size: 21px; line-height: 1.3">{nota.data.titulo}</strong>
            {nota.data.resumen && <span style="color: var(--muted)">{nota.data.resumen}</span>}
          </a>
          <AutoraTag autora={autora} />
        </article>
      ))}
    </div>
  </section>
</Base>
