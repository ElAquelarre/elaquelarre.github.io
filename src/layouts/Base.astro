---
// Plantilla provisional: estructura del wireframe, sin diseño final.
// El diseño visual lo define Gabriela; aquí solo hay lo mínimo para leer cómodo.
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Notas de Aquelarre, comunidad gamer femenina.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- La web aún no está lanzada: que los buscadores no indexen las notas -->
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --ink: #111; --muted: #555; --line: #111; --soft: #EDEDED; }
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; font-family: 'Inter', system-ui, sans-serif; color: var(--ink); background: #fff; line-height: 1.6; }
      a { color: var(--ink); }
      a:hover { color: var(--muted); }
      a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
      .wrap { padding: 0 4%; }
      header.site { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 4%; border-bottom: 1.5px solid var(--line); }
      header.site a.logo { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; text-decoration: none; }
      footer.site { margin-top: 80px; padding: 32px 4%; border-top: 1.5px solid var(--line); color: var(--muted); font-size: 14px; }
      .ph { background: var(--soft); border: 1.5px dashed #9A9A9A; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 13px; }
      .avatar { width: 44px; height: 44px; border-radius: 999px; object-fit: cover; flex: none; background: var(--soft); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; border: 1.5px solid var(--line); }
      .meta { font-size: 13px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="logo" href="/notas/">Aquelarre · Notas</a>
      <a href="https://www.instagram.com/aql.team/">Instagram @aql.team</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">Hasta la próxima luna llena. · © {new Date().getFullYear()} Aquelarre</footer>
  </body>
</html>
