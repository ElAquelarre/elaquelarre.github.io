---
// Versión de prueba de la web completa (estructura del wireframe v2, sin diseño visual).
// Vive en /prueba/, oculta: sin enlaces desde la portada y fuera de los buscadores.
// Cuando el equipo apruebe estructura y diseño, estas páginas pasan a la raíz.
interface Props {
  title: string;
}
const { title } = Astro.props;
const p = '/prueba';
const menu = [
  { href: `${p}/`, label: 'Inicio' },
  { href: `${p}/nosotras/`, label: 'Nosotras' },
  { href: `${p}/lo-que-hemos-hecho/`, label: 'Lo que hemos hecho' },
  { href: `${p}/torneos/`, label: 'Torneos' },
  { href: `${p}/entradas/`, label: 'Entradas' },
  { href: `${p}/notas/`, label: 'Notas' },
  { href: `${p}/apoyanos/`, label: 'Apóyanos' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Aquelarre (prueba)</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --ink: #111; --muted: #555; --soft: #EDEDED; --bg: #fff; --alt: #F4F4F4; }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; overflow-x: hidden; }
      body.menu-abierto { overflow: hidden; }
      a { color: var(--ink); }
      a:hover { color: var(--muted); }
      img { max-width: 100%; }
      [hidden] { display: none !important; }
      .btn:active, .icon:active, .lift:active { transform: scale(0.97); }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
      .wrap { padding-left: max(16px, 4%); padding-right: max(16px, 4%); }
      .ph { background: var(--soft); border: 1.5px dashed #9A9A9A; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--muted); font-size: 13px; font-weight: 500; padding: 12px; }
      .lift { transition: transform .35s cubic-bezier(.22,1,.36,1); }
      .lift:hover { transform: translateY(-6px); }
      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1.5px solid var(--ink); border-radius: 999px; font: 600 15px/1 'Inter', system-ui, sans-serif; text-decoration: none; color: var(--ink); background: #fff; cursor: pointer; }
      .btn:hover, .btn[aria-pressed="true"] { background: var(--ink); color: #fff; }
      .btn.dark { background: var(--ink); color: #fff; }
      .btn.dark:hover { background: #444; }
      .btn.ghost { background: transparent; color: #fff; border-color: #fff; }
      .btn.ghost:hover { background: #fff; color: var(--ink); }
      .icon { width: 48px; height: 48px; border: 1.5px solid var(--ink); border-radius: 999px; background: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex: none; }
      .kicker { margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
      .meta { font-size: 13px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
      h1.titulo { margin: 0; font-size: clamp(40px, 6vw, 84px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; }
      h2.sec { margin: 0; font-size: clamp(26px, 3vw, 32px); font-weight: 800; letter-spacing: -0.02em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 24px; }
      .card { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); }
      .box { border: 1.5px solid var(--ink); border-radius: 16px; padding: 20px; }
      .row { display: flex; flex-wrap: wrap; gap: 32px; }
      .row > * { min-width: 0; }
      .oscura { background: var(--ink); color: #fff; }
      .oscura a:not(.btn) { color: #fff; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; }
      .gato { width: 140px; height: 90px; }
      .avatar-ph { aspect-ratio: 1; border-radius: 12px; }
      .avatar-ph img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }

      /* Aviso de prueba */
      .aviso { background: #FFF4C2; color: #111; font-size: 13px; padding: 8px max(16px, 4%); text-align: center; }

      /* Texto rotativo */
      .marq-box { background: var(--ink); color: #fff; overflow: hidden; white-space: nowrap; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 10px 0; }
      .marq { display: inline-block; padding-left: 100%; animation: mq 40s linear infinite; }
      @keyframes mq { to { transform: translateX(-100%); } }
      @media (prefers-reduced-motion: reduce) { .marq { animation: none; padding-left: 16px; } .lift, .lift:hover { transform: none; } }

      /* Cabecera y menú */
      header.site { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 20px; padding-bottom: 20px; border-bottom: 1.5px solid var(--ink); }
      .logo { display: block; height: 80px; width: auto; }
      header.site { padding-top: 14px; padding-bottom: 14px; }
      footer.site .logo { height: 100px; }
      .solo-ancho { display: inline-flex; }
      @media (max-width: 520px) { .solo-ancho { display: none; } .logo { height: 64px; } }
      #menu { position: fixed; inset: 0; z-index: 50; background: #fff; overflow-y: auto; padding-top: 20px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 32px; }
      #menu[hidden] { display: none; }
      .bigl { font-size: clamp(32px, 6vw, 72px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; text-decoration: none; color: var(--ink); }
      .bigl:hover, .bigl[aria-current="page"] { color: #777; }

      footer.site { display: flex; flex-wrap: wrap; gap: 40px; padding-top: 48px; padding-bottom: 32px; justify-content: space-between; border-top: 1.5px solid var(--ink); }
      footer.site > * { flex: 1 1 200px; display: flex; flex-direction: column; gap: 8px; }
    </style>
  </head>
  <body>
    <p class="aviso">Versión de prueba: solo estructura, sin diseño final. Los textos entre [CORCHETES] están pendientes.</p>
    <div class="marq-box" aria-hidden="true">
      <div class="marq">[TEXTO ROTATIVO] · [FRASE DEL AQUELARRE] · [PRÓXIMO EVENTO: NOMBRE + FECHA] · [FRASE] · [FRASE] · [FRASE]</div>
    </div>

    <header class="site wrap">
      <a href={`${p}/`} aria-label="Aquelarre, inicio" style="text-decoration: none"><img class="logo" src="/assets/logo-aql-negro.png" alt="Aquelarre" width="80" height="64" /></a>
      <div style="display: flex; align-items: center; gap: 12px">
        <a class="btn solo-ancho" href={`${p}/#unete`}>Únete al Discord</a>
        <button class="icon" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu" data-menu-abrir>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>
      </div>
    </header>

    <nav id="menu" class="wrap" aria-label="Menú principal" hidden>
      <div style="display: flex; justify-content: space-between; align-items: center">
        <img class="logo" src="/assets/logo-aql-negro.png" alt="Aquelarre" width="80" height="64" />
        <button class="icon" type="button" aria-label="Cerrar menú" data-menu-cerrar>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        </button>
      </div>
      <div class="row" style="gap: 48px">
        <div style="flex: 2 1 420px; display: flex; flex-direction: column; gap: 10px">
          {menu.map((m) => (
            <a class="bigl" href={m.href} aria-current={Astro.url.pathname === m.href ? 'page' : undefined}>{m.label}</a>
          ))}
        </div>
        <div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 16px">
          <div class="ph" style="height: 240px">GATO (nuevo diseño) — ilustración del menú</div>
          <p style="margin: 0; color: var(--muted)">Discord · <a href="https://www.instagram.com/aql.team/">Instagram @aql.team</a> · [OTRAS REDES]</p>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site wrap">
      <div>
        <img class="logo" src="/assets/logo-aql-negro.png" alt="Aquelarre" width="80" height="64" />
        <p style="margin: 4px 0 0; font-weight: 600">Hasta la próxima luna llena.</p>
      </div>
      <nav aria-label="Pie de página">
        {menu.slice(1).map((m) => <a href={m.href}>{m.label}</a>)}
      </nav>
      <div>
        <a href="https://www.instagram.com/aql.team/">Instagram</a>
        <a href="#">Discord</a>
        <span style="color: var(--muted)">[CORREO DE CONTACTO]</span>
      </div>
      <p style="flex: 1 1 100%; margin: 16px 0 0; font-size: 13px; color: var(--muted)">© {new Date().getFullYear()} Aquelarre</p>
    </footer>

    <script>
      // Menú hamburguesa
      const menu = document.getElementById('menu')!;
      const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]')!;
      const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-cerrar]')!;
      const set = (open: boolean) => {
        menu.hidden = !open;
        abrir.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-abierto', open);
        (open ? cerrar : abrir).focus();
      };
      abrir.addEventListener('click', () => set(true));
      cerrar.addEventListener('click', () => set(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) set(false); });

      // Filtros por categoría: <div data-filtros="x"> con botones data-f, ítems con data-grupo="x" data-tag
      document.querySelectorAll<HTMLElement>('[data-filtros]').forEach((grupo) => {
        const nombre = grupo.dataset.filtros;
        const botones = grupo.querySelectorAll<HTMLButtonElement>('button[data-f]');
        botones.forEach((b) => b.addEventListener('click', () => {
          botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
          document.querySelectorAll<HTMLElement>(`[data-grupo="${nombre}"]`).forEach((it) => {
            it.hidden = b.dataset.f !== '*' && it.dataset.tag !== b.dataset.f;
          });
        }));
      });
    </script>
  </body>
</html>
